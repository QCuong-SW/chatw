# ==========================================
# 🚀 ChatApp Monorepo .gitignore
# ==========================================

# ------------------------------------------
# Dependencies
# ------------------------------------------
node_modules/
client/node_modules/
server/node_modules/
.pnp
.pnp.js

# ------------------------------------------
# Environment Variables & Secrets (Keep .env.example)
# ------------------------------------------
.env
.env*.local
.env.development
.env.test
.env.production
client/.env
client/.env*.local
server/.env
server/.env*.local
!.env.example
!client/.env.example
!server/.env.example

# ------------------------------------------
# Next.js Build Outputs (Client)
# ------------------------------------------
client/.next/
client/out/
client/build/
.next/
out/
build/

# ------------------------------------------
# NestJS Build Outputs & Cache (Server)
# ------------------------------------------
server/dist/
server/tsconfig.tsbuildinfo
dist/
*.tsbuildinfo

# ------------------------------------------
# Runtime Data, Uploads & Local Databases
# ------------------------------------------
server/uploads/
server/.data/
uploads/
.data/
mongo_data/
redis_data/

# ------------------------------------------
# Logs & Debugging
# ------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# OS & System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------
# IDE & Code Editors
# ------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project

# ------------------------------------------
# Testing & Code Coverage
# ------------------------------------------
coverage/
.nyc_output/

# ------------------------------------------
# Temporary & Cache
# ------------------------------------------
.temp/
.tmp/
.cache/
client/.turbo/
server/.turbo/
.turbo/
